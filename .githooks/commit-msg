#!/bin/sh
# 约定式提交校验：type(scope): subject
msg_file="$1"
subject=$(head -n1 "$msg_file")

case "$subject" in
  Merge*|Revert*) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore)(\([a-zA-Z0-9._-]+\))?!?: .+'
if echo "$subject" | grep -Eq "$pattern"; then
  exit 0
fi

echo "提交信息不符合约定式提交规范" >&2
echo "  当前: $subject" >&2
echo "  示例: feat(ui): add theme toggle" >&2
echo "        fix(arc): align sun and moon markers" >&2
exit 1
