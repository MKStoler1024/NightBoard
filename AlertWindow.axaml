<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NightBoard.AlertWindow"
        Title="气象预警"
        Width="620"
        SizeToContent="Height"
        Background="Transparent"

        FontFamily="{StaticResource FontUi}"
        FontSize="14"
        SystemDecorations="Full" ShowInTaskbar="False"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Focusable="True">

  <Window.Styles>
  </Window.Styles>

  <Border
          ClipToBounds="True">
  <Grid Margin="30,24" RowDefinitions="Auto,*,Auto">

    <TextBlock Grid.Row="0" Text="气象预警" FontSize="20"
               FontFamily="{StaticResource FontMedium}" LetterSpacing="2" Margin="0,0,0,16"/>

    <ScrollViewer Grid.Row="1" MaxHeight="560" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="List" Spacing="20"/>
    </ScrollViewer>

    <Button Classes="board quiet" Grid.Row="2" Content="关闭" HorizontalAlignment="Right" Margin="0,18,0,0"
            Click="OnClose"/>
  </Grid>
  </Border>
</Window>
