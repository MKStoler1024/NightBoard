<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NightBoard.IconSheetWindow"
        Title="图标预览"
        Width="760"
        Height="540"

        SystemDecorations="Full" ShowInTaskbar="False"
        CanResize="True"
        WindowStartupLocation="CenterOwner">
  <Border
          ClipToBounds="True">
    <Grid Margin="20" RowDefinitions="Auto,*"><TextBlock Text="天气图标" FontSize="20" Margin="0,0,0,12"/><ScrollViewer Grid.Row="1"><WrapPanel x:Name="Sheet"/></ScrollViewer></Grid>
  </Border>
</Window>
